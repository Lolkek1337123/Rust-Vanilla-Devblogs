# =============================================================================
# Git Ignore Configuration for Rust Vanilla Devblogs Archive & Toolchain
# =============================================================================

# Ignore all downloaded game contents in Rust_Devblog_* folders
Rust_Devblog_*/**
!Rust_Devblog_*/
!Rust_Devblog_*/server/
!Rust_Devblog_*/client/
!Rust_Devblog_*/server/Start_Server.bat
!Rust_Devblog_*/client/Start_Client.bat

# --- Executables, Libraries & Debug Symbols ---
*.exe
*.dll
*.so
*.dylib
*.pdb
*.mdb

# --- Unity Engine & Rust Game Asset Bundles ---
*_Data/
Bundles/
StreamingAssets/
MonoBleedingEdge/
EasyAntiCheat/
*.assets
*.assets.resS
*.resource
*.bundle
*.sharedAssets*
*.unitypackage
*.unityweb
*.map
*.sav
*.db
*.db-journal
*.db-wal
*.db-shm
*.vdf

# --- Server Runtimes, Saves & Logs ---
*.log
cfg/
oxide/
carbon/
logs/
save/
output_log.txt

# --- Steam, DepotDownloader & Temporary Files ---
steamapps/
steamcmd/
tools/
DepotDownloader/
.depotDownloader/
_gdrive_uploads/
temp_*.zip
*.zip
*.tar.gz
*.7z
*.rar
*.tmp
*.temp

# --- OS & Editor Cache ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
